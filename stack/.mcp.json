{
  "$schema": "https://json.schemastore.org/mcp.json",
  "mcpServers": {
    "playwright": {
      "command": "bunx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "chrome-devtools": {
      "command": "bunx",
      "args": [
        "chrome-devtools-mcp@latest"
      ]
    },
    "shadcn": {
      "command": "bunx",
      "args": [
        "--bun",
        "shadcn@latest",
        "mcp"
      ]
    }
  }
}
